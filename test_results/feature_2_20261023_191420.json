    "feature": "FEATURE_2_TRANSACTION_TRACEBACK",
    "test_case": "6 transactions in 1 hour -> VELOCITY_SPIKE (no double counting)",
    "input": {
      "account": "acc_f2_vel",
      "txn_count": 6,
      "window_mins": 30
    },
    "expected_output": {
      "flags": [
        "VELOCITY_SPIKE"
      ],
      "velocity_1hr": 6
    },
    "actual_output": {
      "flags": [
        "VELOCITY_SPIKE"
      ],
      "traceback": {
        "account_transaction_count": 6,
        "previous_transaction_id": "tx_vel_5",
        "previous_transaction_ts": "2026-10-23T12:25:00+00:00",
        "previous_amount": 50.0,
        "previous_merchant": "Amazon",
        "previous_location": "New York",
        "chain_risk_score": 10.0,
        "velocity_1hr": 6,
        "velocity_24hr": 6,
        "amount_delta_pct": 0.0
      },
      "re_eval_velocity_1hr": 6
    },
    "passed": true,
    "notes": "6th transaction in 1h window raises VELOCITY_SPIKE and avoids double-counting current transaction."
  },
