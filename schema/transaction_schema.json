{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudGuard Enriched Transaction Event Schema",
  "type": "object",
  "required": [
    "transaction_id",
    "timestamp",
    "amount"
  ],
  "properties": {
    "transaction_id": { "type": "string" },
    "account_id": { "type": "string" },
    "source_account": { "type": "string" },
    "destination_account": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "amount": { "type": "number", "minimum": 0.0 },
    "txn_type": { "type": "string" },
    "merchant": { "type": "string" },
    "merchant_category": { "type": "string" },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "decision": { "type": "string", "enum": ["ALLOW", "REVIEW_QUEUE", "BLOCK"] },
    "status": { "type": "string", "enum": ["APPROVED", "PENDING_REVIEW", "QUARANTINED", "RELEASED", "CONFIRMED_FRAUD"] },
    "flags": { "type": "array", "items": { "type": "string" } },
    "origin": {
      "type": "object",
      "properties": {
        "ip_address": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "isp": { "type": "string" },
        "connection_type": { "type": "string", "enum": ["mobile", "broadband", "vpn", "proxy", "tor"] },
        "is_vpn": { "type": "boolean" },
        "is_proxy": { "type": "boolean" },
        "is_tor": { "type": "boolean" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "timezone": { "type": "string" }
      }
    },
    "traceback": {
      "type": "object",
      "properties": {
        "account_transaction_count": { "type": "integer" },
        "previous_transaction_id": { "type": ["string", "null"] },
        "previous_transaction_ts": { "type": ["string", "null"] },
        "previous_amount": { "type": "number" },
        "previous_merchant": { "type": "string" },
        "previous_location": { "type": "string" },
        "chain_risk_score": { "type": "number" },
        "velocity_1hr": { "type": "integer" },
        "velocity_24hr": { "type": "integer" },
        "amount_delta_pct": { "type": "number" }
      }
    },
    "time_analysis": {
      "type": "object",
      "properties": {
        "transaction_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "transaction_day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
        "is_night_transaction": { "type": "boolean" },
        "is_weekend": { "type": "boolean" },
        "account_typical_hours": { "type": "array", "items": { "type": "integer" } },
        "hour_anomaly": { "type": "boolean" },
        "time_since_last_txn_mins": { "type": ["number", "null"] }
      }
    },
    "location_check": {
      "type": "object",
      "properties": {
        "account_registered_city": { "type": "string" },
        "account_registered_country": { "type": "string" },
        "transaction_city": { "type": "string" },
        "transaction_country": { "type": "string" },
        "distance_km": { "type": "number" },
        "is_international": { "type": "boolean" },
        "is_impossible_travel": { "type": "boolean" },
        "travel_speed_kmh": { "type": "number" }
      }
    },
    "pii_enrichment": {
      "type": "object",
      "properties": {
        "data_source": { "type": "string", "const": "MOCK_DEMO_DATA" },
        "enrichment_status": { "type": "string", "enum": ["FOUND", "NOT_FOUND"] },
        "account_holder_name": { "type": "string" },
        "account_age_days": { "type": ["integer", "null"] },
        "linked_phone_verified": { "type": ["boolean", "null"] },
        "social_profile_risk_score": { "type": "number" },
        "device_fingerprint": { "type": "string" },
        "last_known_location": { "type": ["object", "null"] },
        "location_matches_transaction": { "type": "boolean" }
      }
    }
  }
}
